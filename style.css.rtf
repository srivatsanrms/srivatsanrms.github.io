\f0\fs24 \cf0 /* Basic page styling */\
* \{\
    box-sizing: border-box;\
\}\
\
body \{\
    margin: 0;\
    font-family: Arial, sans-serif;\
    line-height: 1.6;\
    background-color: #f4f7fb;\
    color: #222;\
\}\
\
/* Header */\
header \{\
    background-color: #1f3c88;\
    color: white;\
    text-align: center;\
    padding: 30px 20px;\
\}\
\
header h1 \{\
    margin-bottom: 5px;\
\}\
\
header p \{\
    margin-top: 0;\
\}\
\
/* Navigation */\
nav \{\
    margin-top: 20px;\
\}\
\
nav a \{\
    color: white;\
    text-decoration: none;\
    margin: 0 10px;\
    padding: 6px 10px;\
\}\
\
nav a:hover \{\
    background-color: #162d66;\
    border-radius: 5px;\
\}\
\
/* Main content */\
main \{\
    width: 85%;\
    max-width: 1000px;\
    margin: 30px auto;\
\}\
\
section \{\
    background-color: white;\
    margin-bottom: 25px;\
    padding: 25px;\
    border-radius: 10px;\
    border: 1px solid #ddd;\
\}\
\
h2 \{\
    color: #1f3c88;\
    border-bottom: 2px solid #dbe3f5;\
    padding-bottom: 8px;\
\}\
\
/* Cards */\
.card \{\
    background-color: #f7f9fd;\
    padding: 15px;\
    margin: 15px 0;\
    border-left: 4px solid #1f3c88;\
\}\
\
/* Table */\
table \{\
    width: 100%;\
    border-collapse: collapse;\
\}\
\
th,\
td \{\
    border: 1px solid #ccc;\
    padding: 10px;\
    text-align: left;\
\}\
\
th \{\
    background-color: #e8eef9;\
\}\
\
tr:hover \{\
    background-color: #f5f7fa;\
\}\
\
/* Lists */\
li \{\
    margin-bottom: 8px;\
\}\
\
/* Gallery */\
.gallery \{\
    display: flex;\
    gap: 20px;\
    flex-wrap: wrap;\
\}\
\
figure \{\
    margin: 0;\
    width: 30%;\
\}\
\
figure img \{\
    width: 100%;\
    border-radius: 8px;\
\}\
\
figcaption \{\
    text-align: center;\
    margin-top: 5px;\
    color: #555;\
\}\
\
/* Footer */\
footer \{\
    text-align: center;\
    background-color: #1f3c88;\
    color: white;\
    padding: 20px;\
    margin-top: 30px;\
\}\
\
/* Mobile layout */\
@media (max-width: 700px) \{\
    main \{\
        width: 95%;\
    \}\
\
    figure \{\
        width: 100%;\
    \}\
\
    nav a \{\
        display: inline-block;\
        margin: 5px;\
    \}\
\}}